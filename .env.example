# PostgreSQL from docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/auragaze?schema=public"
# Same as DATABASE_URL for local Docker; Neon sets a separate unpooled URL in production
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5433/auragaze?schema=public"

# Generate for each environment: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npx prisma db seed`
ADMIN_EMAIL="admin@auragaze.local"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Google OAuth (Cloud Console → Credentials → OAuth 2.0 Client ID, Web application)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP for verification + password reset emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="AURAGAZE <noreply@yourdomain.com>"

# Cloudinary (Dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Razorpay (Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
